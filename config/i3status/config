general {
    output_format = "i3bar"
    colors = true
    interval = 5
    color_good = "#a6e3a1"
    color_degraded = "#f9e2af"
    color_bad = "#f38ba8"
}

order += "wireless _first_"
order += "ethernet _first_"
order += "cpu_usage"
order += "memory"
order += "disk /"
order += "battery 0"
order += "tztime local"

wireless _first_ {
    format_up = " Wi-Fi %essid %quality "
    format_down = " Wi-Fi off "
}
ethernet _first_ {
    format_up = " LAN %ip "
    format_down = ""
}
cpu_usage {
    format = " CPU %usage "
}
memory {
    format = " RAM %used "
    threshold_degraded = "1G"
    format_degraded = " RAM low: %available free "
}
disk "/" {
    format = " Disk %avail free "
    low_threshold = 10
    threshold_type = "percentage_avail"
}
battery 0 {
    format = " %status %percentage %remaining "
    format_down = ""
    status_chr = "Charging"
    status_bat = "Battery"
    status_full = "Full"
    low_threshold = 15
    threshold_type = "percentage"
    last_full_capacity = true
}
tztime local {
    format = " %a %d %b  |  %H:%M "
}
