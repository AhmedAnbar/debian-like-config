/* A compact Catppuccin-inspired theme matching the i3 gaps and borders. */
* {
    background-color: transparent;
    text-color: @text;
    font: "Noto Sans 12";
    bg: #1e1e2e;
    surface: #313244;
    muted: #6c7086;
    text: #cdd6f4;
    accent: #b4befe;
    accent-alt: #cba6f7;
}

window {
    location: center;
    anchor: center;
    width: 42%;
    border: 2px;
    border-color: @accent;
    border-radius: 14px;
    background-color: @bg;
    padding: 24px;
}

mainbox {
    orientation: vertical;
    children: [ inputbar, listview ];
    spacing: 16px;
}

inputbar {
    orientation: horizontal;
    children: [ prompt, entry ];
    spacing: 10px;
    padding: 12px 14px;
    border-radius: 10px;
    background-color: @surface;
}

prompt {
    expand: false;
    text-color: @accent;
}

entry {
    expand: true;
    text-color: @text;
    placeholder: "Search applications…";
    placeholder-color: @muted;
}

listview {
    lines: 8;
    columns: 1;
    spacing: 6px;
    fixed-height: false;
    dynamic: true;
    scrollbar: false;
}

element {
    orientation: horizontal;
    children: [ element-icon, element-text ];
    padding: 10px;
    border-radius: 9px;
    background-color: transparent;
}

element selected {
    background-color: @surface;
    text-color: @accent;
}

element-text {
    expand: true;
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 1.25em;
    margin: 0 10px 0 0;
}

element-text selected { text-color: @accent; background-color: transparent; }

/* Explicit row states prevent light/default colors leaking into dark palettes. */
element normal.normal { background-color: transparent; text-color: @text; }
element alternate.normal { background-color: transparent; text-color: @text; }
element normal.active { background-color: transparent; text-color: @accent; }
element alternate.active { background-color: transparent; text-color: @accent; }
element normal.urgent { background-color: transparent; text-color: @accent; }
element alternate.urgent { background-color: transparent; text-color: @accent; }
element selected.normal { background-color: @surface; text-color: @accent; }
element selected.active { background-color: @surface; text-color: @accent; }
element selected.urgent { background-color: @surface; text-color: @accent; }
element-text { background-color: transparent; text-color: inherit; }
element-icon { background-color: transparent; text-color: inherit; }
